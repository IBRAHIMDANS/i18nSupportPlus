<idea-plugin>
    <id>com.ibrahimdans.i18n</id>
    <name>I18n Support Plus</name>
    <vendor email="ibrahima.dansoko@outlook.com" url="https://github.com/IBRAHIMDANS/i18nSupportPlus">ibrahimdans</vendor>
    <depends>com.intellij.modules.platform</depends>
    <!-- Optional: without the JavaScript plugin (IntelliJ IDEA Community, Android Studio, PyCharm, an unlicensed IDEA 2025.3+)
         the plugin loads with the translation files alone. Every JavaScript-side extension is in jsConfig.xml: no class
         the trunk registers reaches the JavaScript PSI, which the Plugin Verifier checks on IntelliJ IDEA Community. -->
    <depends optional="true" config-file="jsConfig.xml">JavaScript</depends>
    <depends optional="true" config-file="ymlConfig.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="phpConfig.xml">com.jetbrains.php</depends>
    <depends optional="true" config-file="vueConfig.xml">org.jetbrains.plugins.vue</depends>
    <depends optional="true" config-file="angularConfig.xml">AngularJS</depends>
    <depends optional="true" config-file="svelteConfig.xml">dev.blachut.svelte.lang</depends>
    <depends optional="true" config-file="plainObjectConfig.xml">org.jetbrains.plugins.localization</depends>
    <depends optional="true" config-file="propertiesConfig.xml">com.intellij.properties</depends>
    <depends optional="true" config-file="gitConfig.xml">Git4Idea</depends>
    <depends optional="true" config-file="mcpConfig.xml">com.intellij.mcpServer</depends>
    <depends optional="true" config-file="twigConfig.xml">com.jetbrains.twig</depends>
    <depends optional="true" config-file="jsonConfig.xml">com.intellij.modules.json</depends>
    <resource-bundle>messages.I18nBundle</resource-bundle>
    <extensionPoints>
        <extensionPoint interface="com.ibrahimdans.i18n.Localization" name="localization" dynamic="true"/>
        <extensionPoint interface="com.ibrahimdans.i18n.Lang" name="lang" dynamic="true"/>
        <extensionPoint interface="com.ibrahimdans.i18n.TranslationTechnology" name="technology" dynamic="true"/>
        <extensionPoint interface="com.ibrahimdans.i18n.ComponentSourceProvider" name="componentSources" dynamic="true"/>
        <!-- What a language plugin reads in the code: registered by its config file (jsConfig.xml), absent without it. -->
        <extensionPoint interface="com.ibrahimdans.i18n.CodeReader" name="codeReader" dynamic="true"/>
    </extensionPoints>
    <projectListeners>
        <!-- i18n-check.json read again as soon as it changes. -->
        <listener class="com.ibrahimdans.i18n.plugin.ide.settings.ProjectConfigFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <!-- Review markers of the open translation files redrawn when a review file changes. -->
        <listener class="com.ibrahimdans.i18n.plugin.review.ui.ReviewGutterRefresh"
                  topic="com.ibrahimdans.i18n.plugin.review.ReviewStore$Listener"/>
        <!-- A translation file growing past the IDE's intellisense size limit during the session: told then, not at the next start. -->
        <listener class="com.ibrahimdans.i18n.plugin.ide.notification.LargeTranslationFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
    <extensions defaultExtensionNs="com.intellij">
        <!-- New UI variants of the gutter icons (icons/expui/), applied by the platform when the new UI is on. -->
        <iconMapper mappingFile="I18nIconMappings.json"/>
        <!-- Flutter's ARB catalogues are JSON: read as such, the type Flutter's own plugin gives them. -->
        <fileType name="JSON" extensions="arb"/>
        <!-- XLIFF files (Angular's messages.xlf) are XML; a type of their own keeps every other XML file
             out of the translation sources. The IDE registers none for these extensions. -->
        <fileType name="XLIFF" language="XML" extensions="xlf;xliff" fieldName="INSTANCE"
                  implementationClass="com.ibrahimdans.i18n.extensions.localization.xliff.XliffFileType"/>
        <psi.referenceContributor language="XML" implementation="com.ibrahimdans.i18n.extensions.localization.xliff.XliffReferenceContributor"/>
        <errorHandler implementation="com.ibrahimdans.i18n.plugin.ide.diagnostic.GitHubErrorReportSubmitter"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="com.ibrahimdans.i18n.plugin.ide.codevision.TranslationUsagesCodeVisionProvider"/>
        <notificationGroup id="i18n Support Plus" displayType="STICKY_BALLOON"/>
        <notificationGroup id="i18n Support Plus results" displayType="BALLOON"/>
        <gotoDeclarationHandler implementation="com.ibrahimdans.i18n.plugin.ide.references.code.I18nGotoDeclarationHandler"/>
        <psi.referenceContributor language="JSON" implementation="com.ibrahimdans.i18n.extensions.localization.json.JsonReferenceContributor"/>
        <!-- vue-i18n's linked messages (`@:key`) in a translation value: navigation and unknown keys -->
        <psi.referenceContributor language="JSON" implementation="com.ibrahimdans.i18n.plugin.ide.references.translation.LinkedMessageReferenceContributor"/>
        <annotator language="JSON" implementationClass="com.ibrahimdans.i18n.plugin.ide.references.translation.LinkedMessageAnnotator"/>
        <projectService serviceImplementation="com.ibrahimdans.i18n.plugin.ide.settings.Settings"/>
        <projectConfigurable groupId="tools" displayName="i18n Support Plus" instance="com.ibrahimdans.i18n.plugin.ide.settings.Configurable"/>
        <projectConfigurable parentId="preference.i18nPlugin" id="preference.i18nPlugin.modules"
                             instance="com.ibrahimdans.i18n.plugin.ide.settings.ModulesConfigurable"
                             bundle="messages.I18nBundle" key="settings.modules.page.title"/>
        <projectConfigurable parentId="preference.i18nPlugin" id="preference.i18nPlugin.rules"
                             instance="com.ibrahimdans.i18n.plugin.ide.settings.RulesConfigurable"
                             bundle="messages.I18nBundle" key="settings.rules.page.title"/>
        <projectConfigurable parentId="preference.i18nPlugin" id="preference.i18nPlugin.machineTranslation"
                             instance="com.ibrahimdans.i18n.plugin.translate.MachineTranslationConfigurable"
                             bundle="messages.I18nBundle" key="settings.translate.title"/>
        <!-- Application level: the name reviews are signed with belongs to the person, never to the project. -->
        <applicationConfigurable parentId="preference.i18nPlugin" id="preference.i18nPlugin.reviews"
                                 instance="com.ibrahimdans.i18n.plugin.review.ReviewerConfigurable"
                                 bundle="messages.I18nBundle" key="settings.reviews.title"/>
        <intentionAction>
            <className>com.ibrahimdans.i18n.plugin.ide.actions.ExtractI18nIntentionAction</className>
        </intentionAction>
        <!-- The reference locale's value after each value of a JSON translation file. Declared on JSON
             only: JSON5 is a dialect of it and inherits the provider. YAML is in ymlConfig.xml. -->
        <codeInsight.declarativeInlayProvider language="JSON"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inlay.ReferenceValueInlayHintsProvider"
            providerId="i18n.reference.value.inlay"
            group="OTHER_GROUP"
            bundle="messages.I18nBundle"
            nameKey="inlay.reference.name"/>
        <!-- Review state of each value of a JSON translation file (JSON5 and ARB included), with its decisions on click. -->
        <codeInsight.lineMarkerProvider language="JSON" implementationClass="com.ibrahimdans.i18n.plugin.review.ui.ReviewLineMarkerProvider"/>
        <postStartupActivity implementation="com.ibrahimdans.i18n.plugin.ide.settings.StartupAction"/>
        <postStartupActivity implementation="com.ibrahimdans.i18n.plugin.ide.settings.SetupWizardStartupActivity"/>
        <postStartupActivity implementation="com.ibrahimdans.i18n.plugin.ide.whatsnew.WhatsNewStartupActivity"/>
        <!-- A translation file above the IDE's intellisense size limit: told why its keys are missing. -->
        <postStartupActivity implementation="com.ibrahimdans.i18n.plugin.ide.notification.LargeTranslationFileNotifier"/>
        <toolWindow id="I18n" anchor="bottom" icon="AllIcons.Nodes.ResourceBundle"
                    factoryClass="com.ibrahimdans.i18n.plugin.ide.toolwindow.I18nToolWindowFactory"/>
        <searchEverywhereContributor
                implementation="com.ibrahimdans.i18n.plugin.ide.search.TranslationSearchEverywhereContributor$Factory"/>
        <renameHandler implementation="com.ibrahimdans.i18n.plugin.ide.actions.RenameI18nKeyHandler"/>
        <renamePsiElementProcessor implementation="com.ibrahimdans.i18n.extensions.localization.arb.ArbRenameProcessor" order="first"/>
        <automaticRenamerFactory implementation="com.ibrahimdans.i18n.plugin.ide.actions.RenameNamespaceOption"/>
        <statusBarWidgetFactory id="com.ibrahimdans.i18n.previewLocale"
                                implementation="com.ibrahimdans.i18n.plugin.ide.preview.PreviewLocaleWidgetFactory"
                                order="after positionWidget"/>
        <!-- No language: one inspection for every language the plugin reads keys from. Each element is
             read by the language a `com.ibrahimdans.i18n.lang` extension names for it, so the class
             names no PSI of an optional plugin (JavaScript, PHP, Twig). -->
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.unresolved.key.display.name"
            shortName="I18nUnresolvedKey"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.UnresolvedKeyInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.placeholder.display.name"
            shortName="I18nPlaceholderConsistency"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.PlaceholderConsistencyInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.plural.forms.display.name"
            shortName="I18nMissingPluralForms"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.MissingPluralFormsInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.vue.plural.display.name"
            shortName="I18nVuePluralBranches"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.VueI18nPluralBranchesInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.markup.display.name"
            shortName="I18nMarkupConsistency"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.MarkupConsistencyInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.length.display.name"
            shortName="I18nValueLength"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.ValueLengthInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.glossary.display.name"
            shortName="I18nGlossaryTerm"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.GlossaryTermInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.untranslated.display.name"
            shortName="I18nUntranslatedValue"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.UntranslatedValueInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.style.display.name"
            shortName="I18nValueStyle"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.ValueStyleInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.keyNaming.display.name"
            shortName="I18nKeyNaming"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.KeyNamingInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.icu.display.name"
            shortName="I18nIcuFormat"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.IcuFormatInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.unused.display.name"
            shortName="I18nUnusedKey"
            enabledByDefault="false"
            level="WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.UnusedTranslationKeyInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.empty.display.name"
            shortName="I18nEmptyValue"
            enabledByDefault="false"
            level="WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.EmptyTranslationValueInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.duplicate.display.name"
            shortName="I18nDuplicateValue"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.DuplicateTranslationValueInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.missing.key.display.name"
            shortName="I18nMissingKey"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.MissingTranslationKeyInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.orphan.key.display.name"
            shortName="I18nOrphanKey"
            enabledByDefault="false"
            level="WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.OrphanTranslationKeyInspection"/>
        <localInspection
            groupName="i18n Support Plus"
            key="inspection.stale.display.name"
            shortName="I18nStaleTranslation"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.plugin.ide.inspection.StaleTranslationInspection"/>
    </extensions>
    <actions>
        <!-- One family per section: configuration, keys, machine translation, exchange, generation;
             Show Translation Changes and Compare with Branch close the menu. -->
        <group id="com.ibrahimdans.i18n.ToolsMenu"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="com.ibrahimdans.i18n.RunSetupWizard"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.SetupWizardAction"/>
            <!-- Hidden with fewer than two modules; the module selector's right-click menu holds them too. -->
            <action id="com.ibrahimdans.i18n.FocusModule"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.FocusModuleAction"/>
            <action id="com.ibrahimdans.i18n.ActivateAllModules"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.ActivateAllModulesAction"/>
            <separator/>
            <!-- No default keyboard shortcut: ctrl alt shift and a letter is taken in the default keymap for nearly every letter. -->
            <action id="com.ibrahimdans.i18n.SyncKeys"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.SyncKeysAction"
                    icon="AllIcons.General.Modified"/>
            <action id="com.ibrahimdans.i18n.CleanupUnusedKeys"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.CleanupUnusedKeysAction"/>
            <separator/>
            <action id="com.ibrahimdans.i18n.FillMissingTranslations"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.FillMissingTranslationsAction"/>
            <action id="com.ibrahimdans.i18n.RetranslateStale"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.RetranslateStaleAction"/>
            <separator/>
            <action id="com.ibrahimdans.i18n.ExportTranslations"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.ExportTranslationsAction"/>
            <action id="com.ibrahimdans.i18n.ImportTranslations"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.ImportTranslationsAction"/>
            <separator/>
            <!-- Manual only, and hidden outside i18next modules: the generated file is committed. -->
            <action id="com.ibrahimdans.i18n.GenerateI18nTypes"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.GenerateI18nTypesAction"/>
            <action id="com.ibrahimdans.i18n.GeneratePseudoLocale"
                    class="com.ibrahimdans.i18n.plugin.ide.actions.GeneratePseudoLocaleAction"/>
            <separator/>
        </group>
        <!-- No default shortcut: ctrl alt shift T is Refactor This in the default keymap, which won. -->
        <action id="com.ibrahimdans.i18n.ToggleFolding"
                class="com.ibrahimdans.i18n.plugin.ide.actions.ToggleFoldingAction"
                icon="AllIcons.General.InspectionsEye"/>
        <!-- No default shortcut (see SyncKeys); the status bar widget is the click path. -->
        <action id="com.ibrahimdans.i18n.SwitchPreviewLocale"
                class="com.ibrahimdans.i18n.plugin.ide.actions.SwitchPreviewLocaleAction"/>
        <action id="com.ibrahimdans.i18n.SortI18nKeys"
                class="com.ibrahimdans.i18n.plugin.ide.actions.SortI18nKeysAction"/>
        <!-- ctrl alt shift M is also bound in the default keymap, but only by Database and Kotlin actions,
             disabled in the files this one works on: checked in WebStorm on Linux. -->
        <action id="com.ibrahimdans.i18n.MoveI18nKey"
                class="com.ibrahimdans.i18n.plugin.ide.actions.MoveI18nKeyHandler">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift M"/>
        </action>
        <action id="com.ibrahimdans.i18n.ShowTranslationChanges"
                class="com.ibrahimdans.i18n.plugin.ide.diff.ShowTranslationChangesAction"
                icon="AllIcons.Actions.Diff">
            <add-to-group group-id="com.ibrahimdans.i18n.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.ibrahimdans.i18n.CopyI18nKey"
                class="com.ibrahimdans.i18n.plugin.ide.actions.CopyI18nKeyAction"
                icon="AllIcons.Actions.Copy"/>
        <action id="com.ibrahimdans.i18n.DeleteI18nKey"
                class="com.ibrahimdans.i18n.plugin.ide.actions.DeleteI18nKeyAction"
                icon="AllIcons.Actions.GC"/>
        <!-- No default shortcut: ctrl alt shift I is Run Inspection by Name in the default keymap, which won.
             The editor's i18n submenu and the Edit link of the Ctrl+hover hint are the click paths. -->
        <action id="com.ibrahimdans.i18n.EditTranslationAtCaret"
                class="com.ibrahimdans.i18n.plugin.ide.actions.EditTranslationAtCaretAction"
                icon="AllIcons.Actions.Edit"/>
        <!-- The editor's entries, in a submenu of their own rather than eight lines at the end of the
             context menu. The group hides itself when none of them applies to the file. -->
        <group id="com.ibrahimdans.i18n.EditorMenu"
               class="com.ibrahimdans.i18n.plugin.ide.actions.I18nEditorMenuGroup"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <reference ref="com.ibrahimdans.i18n.EditTranslationAtCaret"/>
            <reference ref="com.ibrahimdans.i18n.CopyI18nKey"/>
            <reference ref="com.ibrahimdans.i18n.MoveI18nKey"/>
            <reference ref="com.ibrahimdans.i18n.DeleteI18nKey"/>
            <separator/>
            <!-- Internationalize sits here too, added by jsConfig.xml where the action is declared. -->
            <reference ref="com.ibrahimdans.i18n.SortI18nKeys"/>
            <separator/>
            <reference ref="com.ibrahimdans.i18n.ToggleFolding"/>
            <reference ref="com.ibrahimdans.i18n.SwitchPreviewLocale"/>
        </group>
        <!-- Consumed by the tool window toolbar, which resolves it by id; it belongs to no
             group so that the table's own scan button could disappear without the feature
             becoming unreachable from Find Action. -->
        <action id="com.ibrahimdans.i18n.ScanOrphanKeys"
                class="com.ibrahimdans.i18n.plugin.ide.actions.ScanOrphanKeysAction"
                icon="AllIcons.Actions.Find"/>
        <action id="com.ibrahimdans.i18n.CleanupOrphanReviews"
                class="com.ibrahimdans.i18n.plugin.review.ui.CleanupReviewsAction">
            <add-to-group group-id="com.ibrahimdans.i18n.ToolsMenu" anchor="after" relative-to-action="com.ibrahimdans.i18n.CleanupUnusedKeys"/>
        </action>
        <action id="com.ibrahimdans.i18n.ShowWhatsNew"
                class="com.ibrahimdans.i18n.plugin.ide.whatsnew.ShowWhatsNewAction">
            <add-to-group group-id="HelpMenu" anchor="last"/>
        </action>
    </actions>
    <extensions defaultExtensionNs="com.ibrahimdans.i18n">
        <localization implementation="com.ibrahimdans.i18n.extensions.localization.json.JsonLocalization"/>
        <!-- i18next and vue-i18n stay here, without JavaScript: their names, and the files the settings name. jsConfig.xml adds what their code says. -->
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.i18next.I18NextTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.vuei18n.VueI18nTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.lingui.LinguiTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.reactintl.ReactIntlTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.ngxtranslate.NgxTranslateTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.transloco.TranslocoTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.sveltei18n.SvelteI18nTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.paraglide.ParaglideTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.i18njs.I18nJsTechnology"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.localization.arb.ArbCatalogues"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.nextintl.NextIntlTechnology"/>
        <!-- Angular's native i18n: the XLIFF files angular.json lists, read as sources. -->
        <localization implementation="com.ibrahimdans.i18n.extensions.localization.xliff.XliffLocalization"/>
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.angulari18n.AngularI18nTechnology"/>
        <!-- Symfony: the catalogues of translations/ (YAML, XLIFF, PHP, JSON), one namespace per domain. -->
        <technology implementation="com.ibrahimdans.i18n.extensions.technology.symfony.SymfonyTranslations"/>
    </extensions>
</idea-plugin>

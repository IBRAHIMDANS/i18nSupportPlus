<idea-plugin>
    <!--
      Angular templates parse their interpolations into the `Angular2` dialect, not into
      `JavaScript`: `{{ 'key' | translate }}` yields a JSLiteralExpression whose language is
      Angular2. Extensions registered for JavaScript therefore never see it, which is why a
      standalone template was not analysed while the same call in a .ts file was.

      The JS implementations work unchanged on those elements — only the registration was
      missing — so this file mirrors vueConfig.xml, which does the same for Vue.

      A template is parsed as Angular only inside an Angular project (a component referencing it
      through templateUrl, with @angular/core resolvable). Outside one it stays plain HTML, and
      nothing here applies.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <annotator language="Angular2" implementationClass="com.ibrahimdans.i18n.extensions.lang.js.AngularCompositeKeyAnnotator"/>
        <psi.referenceContributor language="Angular2" implementation="com.ibrahimdans.i18n.extensions.lang.js.JsReferenceContributor"/>
        <psi.referenceContributor language="Angular2" implementation="com.ibrahimdans.i18n.extensions.lang.js.AngularDirectiveReferenceContributor"/>
        <completion.contributor language="Angular2" implementationClass="com.ibrahimdans.i18n.extensions.lang.js.AngularCompletionContributor"/>
        <!-- The template's markup: the attribute directives written without binding, `transloco="key"`,
             `<p translate>key</p>`. Angular2Html is the base of every Angular template dialect. -->
        <annotator language="Angular2Html" implementationClass="com.ibrahimdans.i18n.extensions.lang.js.AngularCompositeKeyAnnotator"/>
        <psi.referenceContributor language="Angular2Html" implementation="com.ibrahimdans.i18n.extensions.lang.js.AngularDirectiveReferenceContributor"/>
        <completion.contributor language="Angular2Html" implementationClass="com.ibrahimdans.i18n.extensions.lang.js.AngularCompletionContributor"/>
        <!-- A .html template is an Angular17Html file whose expressions sit in its own tree: the
             builder and the hints are declared on Angular2Html, the base of every template dialect.
             Angular2 stays for the expressions injected elsewhere. AngularFoldingBuilder, not
             JsFoldingBuilder: the latter carries JsLang, which folds calls and knows no pipe. -->
        <lang.foldingBuilder language="Angular2" implementationClass="com.ibrahimdans.i18n.extensions.lang.js.AngularFoldingBuilder"/>
        <lang.foldingBuilder language="Angular2Html" implementationClass="com.ibrahimdans.i18n.extensions.lang.js.AngularFoldingBuilder"/>
        <codeInsight.declarativeInlayProvider language="Angular2Html"
            implementationClass="com.ibrahimdans.i18n.extensions.lang.js.AngularInlayHintsProvider"
            providerId="i18n.translations.inlay"
            group="OTHER_GROUP"
            bundle="messages.I18nBundle"
            nameKey="inlay.hints.name"/>
        <lang.documentationProvider language="Angular2" implementationClass="com.ibrahimdans.i18n.plugin.ide.hint.HintProvider"/>
        <localInspection
            language="Angular2Html"
            groupName="i18n Support Plus"
            bundle="messages.I18nBundle"
            key="inspection.hardcoded.angular.text.display.name"
            shortName="I18nHardcodedAngularText"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.ibrahimdans.i18n.extensions.lang.js.HardcodedAngularTextInspection"/>
    </extensions>
</idea-plugin>
